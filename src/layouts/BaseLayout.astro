---
import '../styles/global.css';
import Head from '../components/Head.astro';
import { getLangFromUrl } from '../i18n/utils';
import { Toggle } from 'astro-theme-toggle/components';

const { title = "Krystian Włodek", description = "" } = Astro.props;

const lang = getLangFromUrl(Astro.url) || 'pl';
const path = Astro.url.pathname;

const oppositeLang = lang === 'pl' ? 'EN' : 'PL';

let switchHref;
if (lang === 'pl') {
  switchHref = path.startsWith('/en') ? path : '/en' + path;
} else {
  switchHref = path.replace(/^\/en/, '') || '/';
}
---

<html lang={lang} class="scroll-smooth">
  <Head title={title} description={description} lang={lang} />

  <body class="min-h-screen bg-gray-200 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300">
    <div class="w-full h-screen p-2 md:p-3">
      <div class="w-full h-full bg-white dark:bg-gray-800 rounded-xl shadow-2xl dark:shadow-lg border border-gray-300 dark:border-gray-700 flex flex-col overflow-hidden transition-colors duration-300">

        <!-- HEADER -->
        <div class="flex items-center px-4 py-3 bg-gray-100 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600 gap-4">
          <!-- Światła okienka -->
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>

          <!-- Kontakt i rok -->
          <div class="flex-1 text-xs text-gray-500 dark:text-gray-300 font-mono">
            <a href="mailto:krystian@wlodek.net" class="hover:underline">krystian@wlodek.net</a> — © {new Date().getFullYear()}
          </div>

          <!-- LANGUAGE SWITCHER + THEME TOGGLE -->
          <div class="flex items-center gap-4">
            <a
              href={switchHref}
              class="px-3 py-1 text-xs border border-gray-300 dark:border-gray-500 rounded-md shadow-md dark:shadow-[0_0_15px_rgba(132,204,22,0.3)] transition-colors transition-shadow duration-300 hover:border-lime-400 hover:shadow-[0_0_15px_rgba(132,204,22,0.3)] dark:hover:shadow-[0_0_25px_rgba(132,204,22,0.6)]"
            >
              {oppositeLang}
            </a>

            <Toggle
              class="
                relative w-10 h-10 rounded-full p-1 
                bg-white dark:bg-gray-800 
                shadow-md dark:shadow-lg 
                flex items-center justify-center
                transition-transform transition-shadow duration-300
                hover:scale-110
                hover:shadow-[0_0_20px_rgba(132,204,22,0.5)]
                dark:hover:shadow-[0_0_25px_rgba(132,204,22,0.7)]
              "
            >
              <Fragment slot="icon-light">
                <!-- Słońce -->
                <svg class="w-6 h-6 text-lime-400 transition-colors duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="5"/>
                  <line x1="12" y1="1" x2="12" y2="4"/>
                  <line x1="12" y1="20" x2="12" y2="23"/>
                  <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/>
                  <line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
                  <line x1="1" y1="12" x2="4" y2="12"/>
                  <line x1="20" y1="12" x2="23" y2="12"/>
                  <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/>
                  <line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
                </svg>
              </Fragment>
              <Fragment slot="icon-dark">
                <!-- Księżyc -->
                <svg class="w-6 h-6 text-lime-400 transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
                </svg>
              </Fragment>
            </Toggle>
          </div>
        </div>

        <!-- CONTENT SLOT -->
        <main class="flex-1 overflow-y-auto px-1 py-2">
          <slot />
          <script type="module" src="/src/js/aos-init.js"></script>
        </main>
      </div>
    </div>
  </body>
</html>