---
import '../styles/global.css';
import Head from '../components/Head.astro';
import { getLangFromUrl } from '../i18n/utils';

const { title = "Krystian Włodek", description = "" } = Astro.props;

// Ustalenie języka z URL
const lang = getLangFromUrl(Astro.url) || 'pl';
const path = Astro.url.pathname; // np. "/" lub "/en/about"

// Ustalenie języka przeciwnego
const oppositeLang = lang === 'pl' ? 'EN' : 'PL';

// Dynamiczny link przełączenia języka
let switchHref;
if (lang === 'pl') {
  // z PL → EN: dodaj /en przed ścieżką, jeśli jej jeszcze nie ma
  switchHref = path.startsWith('/en') ? path : '/en' + path;
} else {
  // z EN → PL: usuń /en z początku ścieżki
  switchHref = path.replace(/^\/en/, '') || '/';
}
---
<html lang={lang} class="scroll-smooth">
  <Head title={title} description={description} lang={lang} />

  <body class="min-h-screen bg-gray-200 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300">
    <div class="w-full h-screen p-2 md:p-3">
      <div class="w-full h-full bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-300 dark:border-gray-700 flex flex-col overflow-hidden transition-colors duration-300">

        <!-- HEADER -->
        <div class="flex items-center gap-2 px-4 py-3 bg-gray-100 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>

          <div class="ml-4 text-xs text-gray-500 dark:text-gray-300 font-mono">
            <a href="mailto:krystian@wlodek.net" class="hover:underline">krystian@wlodek.net</a> — © {new Date().getFullYear()}
          </div>

          <!-- LANGUAGE SWITCHER -->
          <div class="ml-auto flex items-center gap-2">
            <a href={switchHref} class="px-3 py-1 text-xs border border-gray-300 dark:border-gray-500 rounded-md shadow-sm hover:bg-gray-100 dark:hover:bg-gray-600 transition text-current">
              {oppositeLang}
            </a>
          </div>
        </div>

        <!-- CONTENT SLOT -->
        <main class="flex-1 overflow-y-auto px-1 py-2">
          <slot />
          <script type="module" src="/src/js/aos-init.js"></script>
        </main>
      </div>
    </div>
  </body>
</html>