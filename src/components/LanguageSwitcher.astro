---
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const targetLang = currentLang === 'pl' ? 'en' : 'pl';
const translatePath = useTranslatedPath(currentLang);
const linkHref = translatePath(Astro.url.pathname, targetLang);
const label = targetLang.toUpperCase();
---

<a
  href={linkHref}
  class="px-3 py-1 text-xs border border-gray-300 dark:border-gray-500 rounded-md shadow-md dark:shadow-[0_0_15px_rgba(132,204,22,0.3)]
         transition-colors transition-shadow duration-300 hover:border-lime-400 hover:shadow-[0_0_15px_rgba(132,204,22,0.3)]
         dark:hover:shadow-[0_0_25px_rgba(132,204,22,0.6)]"
>
  {label}
</a>
