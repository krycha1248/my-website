---
const { title = "Krystian Włodek", description = "", lang = "pl" } = Astro.props;
---
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.svg" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="index, follow" />

  <!-- Hreflang dla Google -->
  <link rel="alternate" hreflang="pl" href="https://wlodek.net/" />
  <link rel="alternate" hreflang="en" href="https://wlodek.net/en/" />

  <!-- Open Graph / Twitter Cards możesz tu dodać jeśli potrzebne -->
</head>